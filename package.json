{
  "name": "local-ui-agent",
  "version": "0.1.0",
  "description": "A local, Pi-powered frontend creation, recreation, audit, and repair agent.",
  "type": "module",
  "private": true,
  "bin": {
    "ui-agent": "./dist/cli.js",
    "uagent": "./bin/uagent.mjs"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "check": "npm run typecheck && npm run lint && npm run test",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run --exclude tests/live/** --exclude tests/e2e/**",
    "test:integration": "vitest run tests/integration",
    "test:e2e": "vitest run tests/e2e",
    "test:live": "vitest run tests/live",
    "dev": "tsx src/cli.ts",
    "ui-agent": "tsx src/cli.ts",
    "eval": "tsx evals/run.ts"
  },
  "dependencies": {
    "@axe-core/playwright": "4.13.0",
    "@earendil-works/pi-agent-core": "0.85.1",
    "@earendil-works/pi-ai": "0.85.1",
    "@earendil-works/pi-coding-agent": "0.85.1",
    "@earendil-works/pi-tui": "0.85.1",
    "chrome-launcher": "1.2.1",
    "commander": "15.0.0",
    "get-port": "7.2.0",
    "lighthouse": "13.4.1",
    "picocolors": "1.1.1",
    "pixelmatch": "7.2.0",
    "playwright": "1.63.0",
    "pngjs": "7.0.0",
    "sharp": "0.35.4",
    "typebox": "1.3.32",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "22.20.3",
    "@types/pngjs": "6.0.5",
    "eslint": "10.10.0",
    "tsx": "4.23.13",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.0",
    "vitest": "5.0.1"
  }
}
